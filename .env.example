# 穿搭评估接口环境变量
# 复制本文件为 .env 后填写真实值；切勿把真实 Key 提交到仓库。

EXPO_PUBLIC_OUTFIT_API_BASE_URL=https://your-api-host.example.com
EXPO_PUBLIC_OUTFIT_API_PATH=/store/pub/openApi/outfitEvaluate.api
EXPO_PUBLIC_OUTFIT_API_KEY=replace-with-your-api-key
EXPO_PUBLIC_OUTFIT_API_TIMEOUT_MS=90000

# 本地调试可设为 1，走 Mock，不请求真实接口
# EXPO_PUBLIC_USE_MOCK_AI=1

# 仅 Mock 时有效
# EXPO_PUBLIC_FORCE_INVALID=1
# EXPO_PUBLIC_FORCE_TONE=aesthetic_buddy
